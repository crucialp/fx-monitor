# 모든 정적 파일 공통 보안 헤더(함수가 만드는 응답은 lib/auth.js 의 SECURITY 로 같은 값)
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self'

# 커뮤니티: 이용자가 쓴 글이 들어가는 화면이라 가장 엄격하게 — 이 사이트의 스크립트 파일만 실행, 외부로는 아무 데도 접속 못 함
/community/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'self'; base-uri 'none'; form-action 'self'; object-src 'none'

# 문의: 이용자가 적은 글이 들어가는 화면이라 커뮤니티와 같이 엄격하게
/contact/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'self'; base-uri 'none'; form-action 'self'; object-src 'none'

/fonts/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable

# 모바일 앱(/app/): 이 사이트의 스크립트만 실행, 같은 사이트 API 에만 접속. 서비스 워커·설치 정보는 늘 새로 확인
/app/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; frame-ancestors 'self'; base-uri 'none'; form-action 'self'; object-src 'none'
/app/sw.js
  Cache-Control: no-cache
/app/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache

# 안드로이드 앱(플레이스토어, dev.pages.fx_monitor.app)이 이 사이트 것임을 확인하는 파일
/.well-known/assetlinks.json
  Content-Type: application/json
  Access-Control-Allow-Origin: *
